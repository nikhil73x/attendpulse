# ==============================================================================
# AttendPulse Backend Production Environment Variables
# Copy this file to .env and configure the values for your deployment
# NEVER commit .env to GitHub
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# CORS Security: URL of your deployed frontend (e.g. Vercel, Netlify, Custom Domain)
# For multiple origins, separate with commas: https://attendpulse.vercel.app,https://my-domain.com
FRONTEND_URL=https://your-frontend-deployment.vercel.app

# Optional: Production PostgreSQL Connection String
# Leave unset or empty to use the built-in atomic file-based persistence
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require
DATABASE_URL=

# Optional: Custom path for file-based database store (e.g. for Render Disk or Railway Volume mount)
# Default: ./server/data/database.json
DATABASE_PATH=

# Optional: Directory path for storage
DATA_DIR=

# Optional: Database SSL enforcement for PostgreSQL (default: true)
DATABASE_SSL=true

# Optional: Session & Token Secret (for future signed JWT cookies)
JWT_SECRET=your_production_secret_key_here
